document.addEventListener('DOMContentLoaded', function () {

  // 找到所有 class 为 more-info3 下的 a 标签
  const links = document.querySelectorAll('.academic_list .more-info-detail .more-info a');
  // 遍历每个 a 标签
  links.forEach(link => {

    // 获取当前文本内容，并用 <br> 替换 ||
    const newContent = link.innerHTML.replace(/\|\|/g, '<br>');

    // 更新 HTML 内容
    link.innerHTML = newContent;
  });

});

document.addEventListener('DOMContentLoaded', function () {
  //公告栏添加点击事件
  const tags = document.querySelectorAll('.tag-item-0-common');
  const notice_contents = document.querySelectorAll('.notice_content_panel .notice_right');

 // const moreBtns = document.querySelectorAll('.notice_content  .wrapper-more');

  for (let i = 0; i < tags.length; i++) {
    tags[i].addEventListener('click', () => {
      // 移除所有标签的下划线
      tags.forEach(t => t.classList.remove('tag-item-0-common-selected'));
      notice_contents.forEach(t => t.style.display = 'none');
      // moreBtns.forEach(t => t.style.display = 'none');
      // 添加当前点击标签的下划线
      tags[i].classList.add('tag-item-0-common-selected');
      notice_contents[i].style.display = 'block';
      // moreBtns[i].style.display = 'flex';
    });
  }
});


