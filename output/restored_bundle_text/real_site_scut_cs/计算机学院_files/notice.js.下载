document.querySelectorAll('.notice_content_panel .notice_left_li .date').forEach(element => {
  const dateStr = element.textContent.trim();
  if (dateStr.includes('-')) {
    const [year, month, day] = dateStr.split('-');
    element.innerHTML = `
      <span class="day">${day}</span>
      <span class="year-month">${year}-${month}</span>
  `;
  }
});



