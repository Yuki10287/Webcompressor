//=======改变日期样式=======
document.querySelectorAll('.news_content .new_list .date').forEach((element, index) => {
  if (index == 0) {
    return;
  }

  const dateStr = element.textContent.trim();
  if (dateStr.includes('-')) {
    const [year, month, day] = dateStr.split('-');
    element.innerHTML = `
      <span class="day">${day}</span>
      <span class="year-month">${year}-${month}</span>
  `;
  }
});


const bigImg = document.querySelector('.new_list .big_pic_panel .list-img-bg img');
const bigImgDate = document.querySelector('.new_list .big_pic_panel .info .date');
const bigImgCt = document.querySelector('.new_list .big_pic_panel .info .ct');


const articleList = document.querySelector('.new_list .wp_article_list');
const listItems = articleList.querySelectorAll('li');

let currentIndex = 0;
let intervalId = null;

// 初始化轮播
function initCarousel() {
  if (!window.globalMobile) {
    // 先清除所有选中状态
    listItems.forEach(item => item.classList.remove('selected'));
    // 选中第一个项目
    listItems[0].classList.add('selected');
    currentIndex = 0;

    showBigPic(listItems[0])
  }else{
    listItems.forEach(item => item.classList.remove('selected'));
    if(intervalId){
      //销毁
      clearInterval(intervalId)
      intervalId=null
    }
    
  }

}

// 初始化轮播
function showBigPic(li) {
  bigImg.src = li.dataset.src

  const day = li.querySelector('.day').textContent;
  const yearMonth = li.querySelector('.year-month').textContent;

  const textC = li.querySelector('.ct a').textContent;

  console.log(bigImgDate)
  console.log(bigImgCt)

  if (yearMonth && day) {
    bigImgDate.textContent = yearMonth + '-' + day
  }

  bigImgCt.textContent = textC

  const linkElement = li.querySelector('.list-img-bg a');
  const link = linkElement.href;

  bigImg.addEventListener('click', function () {
    window.location.href = link;
  });

}

function nextItem() {
  // 移除当前选中状态
  listItems[currentIndex].classList.remove('selected');

  // 更新索引
  currentIndex = (currentIndex + 1) % listItems.length;

  //主页限制最多显示3个
  if(currentIndex>2){
    currentIndex=0;
  }

  // 添加新的选中状态
  listItems[currentIndex].classList.add('selected');

  showBigPic(listItems[currentIndex])
}

function startCarousel() {
  if (intervalId) return;

  if (!window.globalMobile) {
    intervalId = setInterval(nextItem, 5000);
  }
}

// 初始化
initCarousel();
startCarousel();


function debounce(func, wait) {
    let timeout;
    return function () {
        const context = this, args = arguments;
        clearTimeout(timeout);
        timeout = setTimeout(function () {
            func.apply(context, args);
        }, wait);
    };
}

window.addEventListener('resize', debounce(function () {
    initCarousel();
    startCarousel();
    // 你的逻辑代码
}, 250)); // 250毫秒内不再触发才执行


